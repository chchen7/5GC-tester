index 3e1e868..95c1eb6 100644
--- a/internal/pfcp/udp/udp.go
+++ b/internal/pfcp/udp/udp.go
@@ -13,6 +13,24 @@ import (
 	"github.com/free5gc/smf/internal/logger"
 )
 
+var (
+    workerChs  []chan *pfcpUdp.Message
+    numWorkers = 256
+)
+
+func initPool(dispatch func(*pfcpUdp.Message)) {
+    workerChs = make([]chan *pfcpUdp.Message, numWorkers)
+    for i := 0; i < numWorkers; i++ {
+        workerChs[i] = make(chan *pfcpUdp.Message, 2048)
+        go func(workerID int) {
+            logger.PfcpLog.Infof("PFCP Worker %d started", workerID)
+            for msg := range workerChs[workerID] {
+                dispatch(msg) 
+            }
+        }(i)
+    }
+}
+
 const MaxPfcpUdpDataSize = 1024
 
 var Server *pfcpUdp.PfcpServer
@@ -32,6 +50,8 @@ func Run(dispatch func(*pfcpUdp.Message)) {
 	serverIP := smfContext.ListenIP().To4()
 	Server = pfcpUdp.NewPfcpServer(serverIP.String())
 
+	initPool(dispatch)
+
 	err := Server.Listen()
 	if err != nil {
 		logger.PfcpLog.Errorf("Failed to listen: %v", err)
@@ -68,7 +88,24 @@ func Run(dispatch func(*pfcpUdp.Message)) {
 			}
 
 			if msg.PfcpMessage.IsRequest() {
-				go dispatch(msg)
+				//go dispatch(msg)
+				var seid uint64
+                header := msg.PfcpMessage.Header
+
+                if header.S != 0 {
+                    seid = header.SEID
+                } else {
+                    seid = uint64(header.SequenceNumber)
+                }
+
+                workerID := seid % uint64(numWorkers)
+
+                select {
+				case workerChs[workerID] <- msg:
+				default:
+					logger.PfcpLog.Warnf("Worker %d busy (queue full), falling back to goroutine for SEID %d", workerID, seid)
+					go dispatch(msg)
+				}
 			}
 		}
 	}(Server)
